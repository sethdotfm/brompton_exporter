// tessera_exporter te-syslog-alloy/config-native.alloy // Version 1.0
// https://github.com/sethdotfm/tessera_exporter
//
// macOS/Windows hosts need to run Alloy NATIVELY instead of in Docker.
// See the README for details.
//
// Differences from te-syslog-alloy/config.alloy (For Docker):
//   - Listens on :514 directly (no docker-compose port remap to 1514)
//   - Pushes to Loki via its published host port instead of compose DNS

loki.source.syslog "tessera" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "tessera_syslog" }
    // RFC3164 has no year (or timezone) in its timestamp, so trusting it
    // verbatim can produce bogus dates (e.g. year 0001) that Loki rejects.
    // Stamp entries with Alloy's own receipt time instead.
  }

  relabel_rules = loki.relabel.tessera.rules
  forward_to    = [loki.process.tessera.receiver]
}

// Promotes only the syslog fields the dashboard actually filters on into
// real Loki labels. Avoid labelmap-ing everything __syslog_* exposes:
// fields like connection_hostname (DNS-resolved) or message_proc_id
// (changes on every process restart) are high-cardinality and would blow
// up Loki's stream count for no query benefit.
loki.relabel "tessera" {
  forward_to = []

  rule {
    source_labels = ["__syslog_connection_ip_address"]
    target_label  = "connection_ip_address"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "message_facility"
  }

  // Grafana's Logs panel colors/badges lines by a "level" label using its own vocabulary (debug/info/warn/error/critical).
  // Syslog's RFC5424 severity names (informational, notice, warning, ...) don't match that vocabulary, so every line shows up as "UNK" unless you map them explicitly.
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "debug"
    target_label  = "level"
    replacement   = "debug"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "informational|notice"
    target_label  = "level"
    replacement   = "info"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "warning"
    target_label  = "level"
    replacement   = "warn"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "error"
    target_label  = "level"
    replacement   = "error"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "critical|alert|emergency"
    target_label  = "level"
    replacement   = "critical"
  }
}

// You can drop known-routine/noisy messages here before they're stored in Loki.
loki.process "tessera" {
  stage.drop {
    expression          = "(?i)commencing auto save operation"
    drop_counter_reason = "tessera_routine_autosave"
  }

  stage.drop {
    expression          = "(?i)auto save operation succeeded"
    drop_counter_reason = "tessera_routine_autosave"
  }

  forward_to = [loki.write.tessera.receiver]
}

loki.write "tessera" {
  endpoint {
    url = "http://127.0.0.1:3101/loki/api/v1/push"
  }
}
